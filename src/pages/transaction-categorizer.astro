---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/ui/Faq.astro';
import RelatedGuides from '../components/ui/RelatedGuides.astro';
import TransactionCategorizer from '../components/tools/TransactionCategorizer.svelte';
import PrivacyNote from '../components/ui/PrivacyNote.astro';
import { SITE } from '../lib/constants';
import { breadcrumbSchema, faqSchema, webAppSchema, combineSchemas } from '../lib/seo';

const title = 'Transaction Categorizer';
const description =
  'Free transaction categorizer. Add a Category column to any transactions CSV by keyword — then download it back, entirely in your browser. Your data is never uploaded.';

const faqs = [
  { q: 'Is my file uploaded?', a: 'No. The CSV is read, categorized and rebuilt in your browser. Open DevTools → Network — your file is never sent out.' },
  { q: 'What does it add?', a: 'A single new column called “Category” at the end of your file. Every original column and value is kept exactly as it was — nothing is reordered, reformatted or coerced.' },
  { q: 'How are categories chosen?', a: 'By keyword matching on the column you pick (usually the description or payee). It is a transparent, best-effort rule set — descriptions that match no rule become “Uncategorized” rather than being guessed.' },
  { q: 'Will it corrupt my numbers or leading zeros?', a: 'No. It never touches your existing cells, so account numbers like 00123 and long card numbers survive exactly. It only appends the category text.' },
  { q: 'Can I edit the categories after?', a: 'Yes — the output is a normal CSV. Open it in a spreadsheet and adjust any category by hand, or use it as a first pass before importing into your own system.' },
  { q: 'What can I do with the result?', a: 'Feed it into a pivot table, a budgeting sheet, or an import that expects a category column. It turns a raw export into something you can group and summarize in seconds.' },
];

const schema = combineSchemas(
  webAppSchema({
    name: `${title} — ${SITE.name}`,
    url: `${SITE.url}/transaction-categorizer`,
    description,
    category: 'FinanceApplication',
    features: [
      'Appends a Category column to any transactions CSV',
      'Transparent keyword-based categorization',
      'Keeps every original column and value as text',
      'Download or copy the categorized CSV',
      'Runs entirely in your browser, no upload',
    ],
  }),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Transaction Categorizer', url: '/transaction-categorizer' },
  ]),
  faqSchema(faqs),
);
---

<BaseLayout title={title} description={description} schema={schema}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-8">
      <div class="flex items-center gap-2 text-sm text-[color:var(--color-text-mute)] mb-3">
        <a href="/" class="hover:text-[color:var(--color-text)]">Home</a>
        <span>/</span>
        <span class="text-[color:var(--color-text)]">Transaction Categorizer</span>
      </div>
      <h1 class="text-4xl font-bold tracking-tight mb-3">Transaction Categorizer</h1>
      <p class="text-lg text-[color:var(--color-text-mute)] max-w-2xl">
        Drop a transactions CSV and get it back with a Category column added — ready for a spreadsheet or an import. Everything runs in your browser; your data is never uploaded.
      </p>
    </header>

    <PrivacyNote text="Your CSV is categorized in your browser. Open DevTools → Network to verify — your file is never uploaded." />
    <TransactionCategorizer client:load />

    <article class="prose mt-16 max-w-3xl">
      <h2 class="text-2xl font-bold mb-4">From raw export to grouped data</h2>
      <p class="text-[color:var(--color-text-mute)] leading-relaxed mb-6">
        A bank export has no category column, so you cannot pivot or sum by type without tagging every row by hand. This tool does that first pass automatically: pick the description column and it appends a category to each row, keeping the rest of your file untouched, so you can drop it straight into a spreadsheet and summarize.
      </p>

      <h2 class="text-2xl font-bold mb-4 mt-10">Your data, only with one column more</h2>
      <p class="text-[color:var(--color-text-mute)] leading-relaxed mb-6">
        Categorization is a transparent keyword rule set, applied as a best-effort first pass — never a claim of accuracy. Because your original columns are preserved exactly (leading zeros and all), you stay in control: open the result and correct any category before you rely on it.
      </p>
    </article>

    <RelatedGuides />

    <Faq faqs={faqs} />
  </div>
</BaseLayout>
