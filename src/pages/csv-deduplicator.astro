---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/ui/Faq.astro';
import CsvDeduplicator from '../components/tools/CsvDeduplicator.svelte';
import PrivacyNote from '../components/ui/PrivacyNote.astro';
import { SITE } from '../lib/constants';
import { breadcrumbSchema, faqSchema, webAppSchema, combineSchemas } from '../lib/seo';

const title = 'CSV Deduplicator';
const description =
  'Free tool to find and remove duplicate rows in a CSV — exact matches or by a key column like Transaction ID. Runs entirely in your browser, your file is never uploaded.';

const faqs = [
  { q: 'Can I dedupe by just one column?', a: 'Yes. By default a row is a duplicate only when the whole row matches. Click one or more column headers to match on just those — for example, treat rows with the same Transaction ID or Invoice Number as duplicates even if other fields differ.' },
  { q: 'Which duplicate is kept?', a: 'Your choice: the first occurrence (default) or the last. The order of the rows you keep is preserved.' },
  { q: 'What does "ignore case and surrounding spaces" do?', a: 'It treats "ACME " and "acme" as the same value when deciding what is a duplicate. Useful for messy exports where the same entry appears with slightly different formatting.' },
  { q: 'Is my file uploaded?', a: 'No. Everything runs in your browser. Open DevTools → Network — no request carries your file out. Important for bank and transaction data.' },
  { q: 'Does it change the surviving rows?', a: 'No. It only removes duplicate rows; the rows it keeps are byte-for-byte unchanged, including leading zeros and formatting.' },
];

const schema = combineSchemas(
  webAppSchema({
    name: `${title} — ${SITE.name}`,
    url: `${SITE.url}/csv-deduplicator`,
    description,
    category: 'BusinessApplication',
    features: [
      'Dedupe by whole row or by key columns',
      'Keep first or last occurrence',
      'Optional case- and whitespace-insensitive matching',
      'Reports how many rows and groups were affected',
      'Runs entirely in your browser, no upload',
    ],
  }),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'CSV Deduplicator', url: '/csv-deduplicator' },
  ]),
  faqSchema(faqs),
);
---

<BaseLayout title={title} description={description} schema={schema}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-8">
      <div class="flex items-center gap-2 text-sm text-[color:var(--color-text-mute)] mb-3">
        <a href="/" class="hover:text-[color:var(--color-text)]">Home</a>
        <span>/</span>
        <span class="text-[color:var(--color-text)]">CSV Deduplicator</span>
      </div>
      <h1 class="text-4xl font-bold tracking-tight mb-3">CSV Deduplicator</h1>
      <p class="text-lg text-[color:var(--color-text-mute)] max-w-2xl">
        Find and remove duplicate rows — exact matches, or by a key column like Transaction ID. Runs in your browser, nothing uploaded.
      </p>
    </header>

    <PrivacyNote text="Your CSV is processed in your browser. Open DevTools → Network to verify — your file is never uploaded." />
    <CsvDeduplicator client:load />

    <article class="prose mt-16 max-w-3xl">
      <h2 class="text-2xl font-bold mb-4">Two kinds of duplicate</h2>
      <p class="text-[color:var(--color-text-mute)] leading-relaxed mb-6">
        Sometimes a duplicate means the entire row is identical — an export ran twice. Sometimes it means the same <em>key</em> appears more than once — two rows with the same Transaction ID, even if a timestamp or a note differs. This tool handles both: leave the columns unselected to match whole rows, or pick the columns that define identity for your data.
      </p>
    </article>

    <Faq faqs={faqs} />
  </div>
</BaseLayout>
