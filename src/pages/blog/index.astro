---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../lib/constants';
import { breadcrumbSchema, combineSchemas } from '../../lib/seo';

const title = 'Guides';
const description =
  'Practical guides for working with financial data — converting bank CSVs, importing into accounting software, and fixing the ways spreadsheets quietly corrupt your numbers.';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

// Display order of guide categories. Anything without a category falls into
// "More guides" at the end.
const CATEGORY_ORDER = ['Spreadsheets & Excel', 'Accounting imports', 'Cleaning & organizing'];

const grouped = CATEGORY_ORDER.map((cat) => ({
  name: cat,
  posts: posts.filter((p) => p.data.category === cat),
})).filter((g) => g.posts.length > 0);

const uncategorized = posts.filter((p) => !p.data.category || !CATEGORY_ORDER.includes(p.data.category));
if (uncategorized.length) grouped.push({ name: 'More guides', posts: uncategorized });

const schema = combineSchemas(
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Guides', url: '/blog' },
  ]),
  { '@type': 'Blog', name: `${SITE.name} Guides`, url: `${SITE.url}/blog`, description },
);
---

<BaseLayout title={title} description={description} schema={schema}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-12">
      <div class="flex items-center gap-2 text-sm text-[color:var(--color-text-mute)] mb-3">
        <a href="/" class="hover:text-[color:var(--color-text)]">Home</a>
        <span>/</span>
        <span class="text-[color:var(--color-text)]">Guides</span>
      </div>
      <h1 class="text-4xl font-bold tracking-tight mb-3">Guides</h1>
      <p class="text-lg text-[color:var(--color-text-mute)] max-w-2xl">
        Practical, no-nonsense guides for financial data: converting bank exports, importing into accounting software, and avoiding the traps that corrupt your numbers.
      </p>
    </header>

    {posts.length === 0 ? (
      <p class="text-[color:var(--color-text-mute)]">Guides are on the way.</p>
    ) : (
      <div class="space-y-12">
        {grouped.map((group) => (
          <section>
            <div class="flex items-center gap-3 mb-4">
              <h2 class="text-sm font-semibold uppercase tracking-wider text-[color:var(--color-text-mute)]">{group.name}</h2>
              <div class="flex-1 h-px bg-[color:var(--color-border)]"></div>
              <span class="text-xs text-[color:var(--color-text-dim)]">{group.posts.length}</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {group.posts.map((post) => (
                <a
                  href={`/blog/${post.id.replace(/\.md$/, '')}`}
                  class="group block p-5 rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)] hover:border-[color:var(--color-brand-500)] hover:-translate-y-0.5 transition-all"
                >
                  <h3 class="font-semibold mb-2 leading-snug group-hover:text-[color:var(--color-brand-400)] transition-colors">{post.data.title}</h3>
                  <p class="text-sm text-[color:var(--color-text-mute)] leading-relaxed line-clamp-3">{post.data.description}</p>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
