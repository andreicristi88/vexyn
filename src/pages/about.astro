---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/constants';
import { breadcrumbSchema } from '../lib/seo';

const title = 'About';
const description = 'Vexyn is a growing set of free financial data tools that run entirely in your browser — no upload, no signup, no tracking.';
const schema = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'About', url: '/about' },
]);
---

<BaseLayout title={title} description={description} schema={schema}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-4xl font-bold mb-6">About Vexyn</h1>

    <div class="prose-vexyn space-y-5 text-[color:var(--color-text-mute)] leading-relaxed">
      <p>
        Vexyn is a collection of free tools for working with financial data — cleaning CSVs, converting bank exports, reconciling Stripe reports, analyzing statements. The kind of jobs you normally reach for a paid service or a spreadsheet macro to do.
      </p>

      <h2 class="text-2xl font-bold text-[color:var(--color-text)] mt-8 mb-2">The one rule</h2>
      <p>
        Everything runs in your browser. Your file is parsed, transformed and analyzed on your own device — it is never uploaded. That is not a policy we promise to keep; it is how the tools are built. There is no server that touches your data because there is no server in the loop at all. Open your browser's Network panel while you use any tool and you will see it: nothing goes out.
      </p>
      <p>
        This matters most for exactly the data these tools handle. A bank statement, a customer payment report, a transaction export — this is the last kind of file you want to hand to an anonymous website. Local-first processing removes the question entirely.
      </p>

      <h2 class="text-2xl font-bold text-[color:var(--color-text)] mt-8 mb-2">Why it is free</h2>
      <p>
        Because the work happens on your device, there is no per-use server cost to recover. The tools are funded by unobtrusive display ads, which is why you will never see us promise "no ads" — that would be a promise we could not keep. What we do keep: no upload, no signup, no tracking, no accounts.
      </p>

      <h2 class="text-2xl font-bold text-[color:var(--color-text)] mt-8 mb-2">Open source</h2>
      <p>
        The code is on <a class="text-[color:var(--color-brand-400)] hover:underline" href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub</a>. If you want to verify that a tool does what it says, read it.
      </p>

      <h2 class="text-2xl font-bold text-[color:var(--color-text)] mt-8 mb-2">Contact</h2>
      <p>
        Questions, bug reports, or a tool you wish existed: <a class="text-[color:var(--color-brand-400)] hover:underline" href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
    </div>
  </div>
</BaseLayout>
