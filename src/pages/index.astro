---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/constants';
import { ZONES, toolsInZone, AVAILABLE_TOOLS } from '../lib/tools';
import { combineSchemas, itemListSchema } from '../lib/seo';

const websiteSchema = {
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
};
const orgSchema = {
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/logo-512.png`,
  sameAs: [SITE.github],
};
const tools = itemListSchema(
  AVAILABLE_TOOLS.map((t) => ({ name: t.name, url: `/${t.slug}`, description: t.description })),
);
const schema = combineSchemas(websiteSchema, orgSchema, tools);

const zoneAnchor: Record<string, string> = { data: 'data', business: 'business', personal: 'personal' };
---

<BaseLayout schema={schema}>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-[color:var(--color-border)]">
    <div class="absolute inset-0 glow pointer-events-none"></div>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-16 sm:pt-24 sm:pb-20 text-center relative">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[color:var(--color-border)] bg-[color:var(--color-surface)] text-xs text-[color:var(--color-text-mute)] mb-6">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-[color:var(--color-success)]"></span>
        100% in your browser. Your data is never uploaded.
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight mb-6 leading-[1.08]">
        Free financial data tools<br class="hidden sm:block" /> that <span class="text-[color:var(--color-brand-400)]">never leave your device</span>.
      </h1>
      <p class="text-lg text-[color:var(--color-text-mute)] max-w-2xl mx-auto mb-8 leading-relaxed">
        Clean, convert, reconcile and analyze CSVs, bank exports and Stripe reports — the kind of jobs you usually pay a tool for. Everything runs locally in your browser. No upload, no signup.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/csv-cleaner" class="px-6 py-3 rounded-lg bg-[color:var(--color-brand-500)] hover:bg-[color:var(--color-brand-600)] text-white font-medium transition-colors">
          Try the CSV Cleaner
        </a>
        <a href="#tools" class="px-6 py-3 rounded-lg border border-[color:var(--color-border)] hover:border-[color:var(--color-border-strong)] bg-[color:var(--color-surface)] text-[color:var(--color-text)] font-medium transition-colors">
          Browse all tools
        </a>
      </div>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-[color:var(--color-text-mute)]">
        {['No upload, ever', 'No signup', 'Open source (MIT)', 'Works offline'].map((label) => (
          <span class="inline-flex items-center gap-1.5">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand-400)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            {label}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Tools by zone -->
  <section id="tools" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">
    {ZONES.sort((a, b) => a.order - b.order).map((zone) => (
      <div id={zoneAnchor[zone.id]}>
        <div class="flex items-baseline gap-3 mb-6">
          <span class="text-2xl" aria-hidden="true">{zone.icon}</span>
          <div>
            <h2 class="text-2xl font-bold tracking-tight">{zone.name}</h2>
            <p class="text-sm text-[color:var(--color-text-mute)]">{zone.tagline}</p>
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          {toolsInZone(zone.id).map((tool) =>
            tool.available ? (
              <a href={`/${tool.slug}`} class="group block p-5 rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)] hover:border-[color:var(--color-brand-500)] hover:-translate-y-0.5 transition-all">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-xl" aria-hidden="true">{tool.icon}</span>
                  <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded bg-[color:var(--color-success)]/15 text-[color:var(--color-success)] border border-[color:var(--color-success)]/30">Live</span>
                </div>
                <h3 class="font-semibold text-sm mb-1 group-hover:text-[color:var(--color-brand-400)] transition-colors">{tool.name}</h3>
                <p class="text-xs text-[color:var(--color-text-mute)] leading-relaxed">{tool.description}</p>
              </a>
            ) : (
              <div class="block p-5 rounded-xl border border-dashed border-[color:var(--color-border)] bg-[color:var(--color-surface)]/40 opacity-70">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-xl grayscale" aria-hidden="true">{tool.icon}</span>
                  <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded bg-[color:var(--color-surface-2)] text-[color:var(--color-text-dim)] border border-[color:var(--color-border)]">Soon</span>
                </div>
                <h3 class="font-semibold text-sm mb-1 text-[color:var(--color-text-mute)]">{tool.name}</h3>
                <p class="text-xs text-[color:var(--color-text-dim)] leading-relaxed">{tool.description}</p>
              </div>
            ),
          )}
        </div>
      </div>
    ))}
  </section>

  <!-- Why -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-[color:var(--color-border)]">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)]">
        <div class="text-2xl mb-3" aria-hidden="true">🔒</div>
        <h3 class="font-semibold mb-2">Your data stays yours</h3>
        <p class="text-sm text-[color:var(--color-text-mute)] leading-relaxed">Bank statements and payment reports are the last thing you want to upload to a random web tool. Vexyn processes everything in your browser — open DevTools → Network and confirm your file is never sent out.</p>
      </div>
      <div class="p-6 rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)]">
        <div class="text-2xl mb-3" aria-hidden="true">💸</div>
        <h3 class="font-semibold mb-2">Free, for jobs that usually cost</h3>
        <p class="text-sm text-[color:var(--color-text-mute)] leading-relaxed">CSV-to-QBO conversion, Stripe reconciliation, bank statement analysis — these are normally paid tools. Because the work happens on your device, there is no server cost to pass on.</p>
      </div>
      <div class="p-6 rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)]">
        <div class="text-2xl mb-3" aria-hidden="true">🎯</div>
        <h3 class="font-semibold mb-2">Values kept exactly</h3>
        <p class="text-sm text-[color:var(--color-text-mute)] leading-relaxed">Account numbers keep their leading zeros, long card numbers do not turn into scientific notation. The most common way tools silently corrupt financial data is something Vexyn refuses to do.</p>
      </div>
    </div>
  </section>
</BaseLayout>
