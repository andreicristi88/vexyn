---
import BaseLayout from '../layouts/BaseLayout.astro';
import CsvToJson from '../components/tools/CsvToJson.svelte';
import PrivacyNote from '../components/ui/PrivacyNote.astro';
import { SITE } from '../lib/constants';
import { breadcrumbSchema, faqSchema, webAppSchema, combineSchemas } from '../lib/seo';

const title = 'CSV to JSON';
const description =
  'Free CSV to JSON converter that runs in your browser. Output an array of objects or arrays, pretty or minified. Values stay as text. Nothing is uploaded.';

const faqs = [
  { q: 'What JSON shapes are supported?', a: 'Two: an array of objects (each row becomes {header: value}), and an array of arrays (the first entry is the headers). Objects is the common choice for APIs and code; arrays is compact and preserves column order exactly.' },
  { q: 'Are numbers converted?', a: 'No. Every value stays a string, so 00123 stays "00123" and long numbers are not mangled. If you need typed numbers, cast them in your own code where you control the rules — this tool will not silently change your data.' },
  { q: 'Is my file uploaded?', a: 'No. Conversion happens entirely in your browser. Open DevTools → Network — nothing is sent.' },
  { q: 'Can I handle large files?', a: 'Up to about 50 MB. The on-screen preview is truncated for very large output, but the download and copy always contain everything.' },
];

const schema = combineSchemas(
  webAppSchema({
    name: `${title} — ${SITE.name}`,
    url: `${SITE.url}/csv-to-json`,
    description,
    category: 'DeveloperApplication',
    features: ['Array of objects or array of arrays', 'Pretty or minified', 'Values kept as strings', 'Runs entirely in your browser, no upload'],
  }),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'CSV to JSON', url: '/csv-to-json' },
  ]),
  faqSchema(faqs),
);
---

<BaseLayout title={title} description={description} schema={schema}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-8">
      <div class="flex items-center gap-2 text-sm text-[color:var(--color-text-mute)] mb-3">
        <a href="/" class="hover:text-[color:var(--color-text)]">Home</a>
        <span>/</span>
        <span class="text-[color:var(--color-text)]">CSV to JSON</span>
      </div>
      <h1 class="text-4xl font-bold tracking-tight mb-3">CSV to JSON</h1>
      <p class="text-lg text-[color:var(--color-text-mute)] max-w-2xl">
        Turn a CSV into clean JSON — array of objects or arrays, pretty or minified. Values stay as text. Everything runs in your browser.
      </p>
    </header>

    <PrivacyNote text="Your CSV is converted in your browser. Open DevTools → Network to verify — nothing is uploaded." />
    <CsvToJson client:load />

    <article class="prose mt-16 max-w-3xl">
      <h2 class="text-2xl font-bold mb-4">FAQ</h2>
      <div class="space-y-4">
        {faqs.map((f) => (
          <div class="p-5 rounded-lg bg-[color:var(--color-surface)] border border-[color:var(--color-border)]">
            <h3 class="font-semibold mb-2">{f.q}</h3>
            <p class="text-sm text-[color:var(--color-text-mute)] leading-relaxed">{f.a}</p>
          </div>
        ))}
      </div>
    </article>
  </div>
</BaseLayout>
