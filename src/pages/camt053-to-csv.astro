---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/ui/Faq.astro';
import RelatedGuides from '../components/ui/RelatedGuides.astro';
import BankFormatToCsv from '../components/tools/BankFormatToCsv.svelte';
import PrivacyNote from '../components/ui/PrivacyNote.astro';
import { SITE } from '../lib/constants';
import { breadcrumbSchema, faqSchema, webAppSchema, combineSchemas } from '../lib/seo';

const title = 'CAMT.053 to CSV converter for ISO 20022 statements';
const description =
  'Free CAMT.053 to CSV converter that runs in your browser. Reads ISO 20022 bank statements (camt.052 and camt.054 too) into a clean spreadsheet, with counterparties, purposes and SEPA references. Nothing is uploaded.';

const faqs = [
  { q: 'What is a CAMT.053 file?', a: 'The ISO 20022 bank-to-customer statement — XML, and the successor to MT940 at most European banks. camt.052 is the same layout for intraday reports and camt.054 for debit and credit notifications; all three read here through the same path.' },
  { q: 'Who is the counterparty on each row?', a: 'The other side of the money. For a debit (money out) that is the creditor; for a credit (money in) it is the debtor. The IBAN comes along when the bank includes it. A reversal (RvslInd) flips the direction, so a reversed debit shows as money coming back.' },
  { q: 'What happens with batch bookings?', a: 'One entry can carry several transactions with their own amounts — a salary run, a bulk supplier payment. Those are expanded to one row per transaction, using each one\'s own amount, and the converter says how many entries it expanded. An entry with one transaction stays one row.' },
  { q: 'Are the amounts changed?', a: 'No. ISO 20022 amounts are already plain decimals, so they are taken as written and only signed — negative for debits, positive for credits.' },
  { q: 'My bank\'s file has ns2: in front of every tag. Does it read?', a: 'Yes. Namespace prefixes are stripped; the same file with or without them reads identically.' },
  { q: 'Is my statement uploaded?', a: 'No. The file is read in your browser. Open DevTools → Network — your statement is never sent out.' },
];

const schema = combineSchemas(
  webAppSchema({
    name: `${title} — ${SITE.name}`,
    url: `${SITE.url}/camt053-to-csv`,
    description,
    category: 'FinanceApplication',
    features: ['Reads camt.053, camt.052 and camt.054', 'Counterparty, IBAN and purpose per row', 'SEPA end-to-end and mandate references', 'Batch bookings expanded', 'Runs entirely in your browser, no upload'],
  }),
  breadcrumbSchema([{ name: 'Home', url: '/' }, { name: 'CAMT.053 to CSV', url: '/camt053-to-csv' }]),
  faqSchema(faqs),
);
---

<BaseLayout title={title} description={description} schema={schema}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-8">
      <div class="flex items-center gap-2 text-sm text-[color:var(--color-text-mute)] mb-3">
        <a href="/" class="hover:text-[color:var(--color-text)]">Home</a><span>/</span><span class="text-[color:var(--color-text)]">CAMT.053 to CSV</span>
      </div>
      <h1 class="text-4xl font-bold tracking-tight mb-3">CAMT.053 to CSV</h1>
      <p class="text-lg text-[color:var(--color-text-mute)] max-w-2xl">
        Turn an ISO 20022 bank statement into a spreadsheet — one row per transaction, counterparty and purpose named, batch bookings expanded. Entirely in your browser.
      </p>
    </header>

    <PrivacyNote text="Your statement is read in your browser. Open DevTools → Network to verify — the file is never uploaded." />
    <BankFormatToCsv format="camt" client:load />

    <article class="prose mt-16 max-w-3xl">
      <h2 class="text-2xl font-bold mb-4">Deeply nested XML, flattened without losing the parts that matter</h2>
      <p class="text-[color:var(--color-text-mute)] leading-relaxed mb-6">
        A camt.053 entry buries what a bookkeeper needs five or six levels down: the counterparty under RltdPties, the purpose under RmtInf, the references under Refs, the bank's own description in AddtlNtryInf. This walks all of it and lays the result out flat — date, value date, signed amount, counterparty and its IBAN, purpose, bank reference, end-to-end reference, mandate, transaction code, status and the bank's description — so the file can be sorted, totalled or matched against invoices like any other spreadsheet.
      </p>
      <h2 class="text-2xl font-bold mb-4 mt-10">Checked against the parser GnuCash uses</h2>
      <p class="text-[color:var(--color-text-mute)] leading-relaxed mb-6">
        The same entries were fed to this converter and to the aqbanking camt importer that ships with GnuCash, and the dates, amounts, counterparties, purposes and end-to-end references agreed. Two places this reads further than the reference: it keeps the bank's own reference (AcctSvcrRef), and it opens files whose tags carry a namespace prefix, which aqbanking cannot.
      </p>
      <h2 class="text-2xl font-bold mb-4 mt-10">Other bank formats</h2>
      <p class="text-[color:var(--color-text-mute)] leading-relaxed mb-6">
        Older exports are SWIFT text — the <a href="/mt940-to-csv" class="text-[color:var(--color-brand-400)] hover:underline">MT940 to CSV</a> converter reads those. Personal-finance downloads come as OFX or QBO, for the <a href="/ofx-to-csv" class="text-[color:var(--color-brand-400)] hover:underline">OFX to CSV</a> converter. A statement that only exists as a PDF goes through <a href="/bank-statement-pdf-to-csv" class="text-[color:var(--color-brand-400)] hover:underline">Bank Statement PDF to CSV</a>.
      </p>
    </article>

    <RelatedGuides />
    <Faq faqs={faqs} />
  </div>
</BaseLayout>
