# HTML — revalidate fiecare cerere (deploy nou = imediat la utilizator)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cache-Control: public, max-age=0, must-revalidate
  # Content-Security-Policy se injecteaza AICI la build de scripts/generate-csp.mjs,
  # care hash-uieste fiecare script inline din dist/. Nu-l scrie de mana: hash-urile
  # se schimba la orice editare a scripturilor inline. Linia de mai jos e un
  # comentariu, deci un build fara script livreaza fara CSP, nu cu unul stricat.
  #CSP#

# Assets cu hash din build — cache infinit (Astro pune hash in filename)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Imagini și fonturi din public — cache lung
/*.svg
  Cache-Control: public, max-age=86400
/*.png
  Cache-Control: public, max-age=86400
/*.webp
  Cache-Control: public, max-age=86400
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Manifest + favicon — cache mediu
/favicon.svg
  Cache-Control: public, max-age=86400
/manifest.webmanifest
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
