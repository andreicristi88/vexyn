---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { SITE } from '../lib/constants';
import { cleanPath } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Skip the value suffix on the title (for content pages like guides). */
  plainTitle?: boolean;
  schema?: Record<string, any>;
}

const {
  title = SITE.title,
  description = SITE.description,
  image = '/og-default.png',
  noindex = false,
  plainTitle = false,
  schema,
} = Astro.props;

// cleanPath strips the .html that build.format:'file' puts in the pathname —
// without it every page declares a canonical the sitemap and internal links
// never use, and the homepage claims to live at /index.html.
const canonical = new URL(cleanPath(Astro.url.pathname), SITE.url).toString();
const ogImage = new URL(image, SITE.url).toString();
// Tool/static page names are short ("CSV Cleaner"). Add a value suffix so the
// title carries a keyword and length search engines prefer, while long content
// titles (guides) and the homepage stay as they are.
const fullTitle =
  title === SITE.title
    ? title
    : !plainTitle && title.length < 34
      ? `${title} — ${SITE.name} · Free, no upload`
      : `${title} — ${SITE.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <!-- Tab icon: the bare shield, same artwork as the on-page logo. Apple's
         home-screen icon must be a PNG with its own background — iOS composites
         a transparent icon onto black — so it uses the dark-backed logo. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="apple-touch-icon" href="/logo-256.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="canonical" href={canonical} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0a0a0f" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />

    <!-- Preload primary UI font weights — prevents FOIT on the hero -->
    <link rel="preload" as="font" type="font/woff2" crossorigin
      href="https://cdn.jsdelivr.net/npm/@fontsource/geist-sans@5/files/geist-sans-latin-400-normal.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin
      href="https://cdn.jsdelivr.net/npm/@fontsource/geist-sans@5/files/geist-sans-latin-600-normal.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin
      href="https://cdn.jsdelivr.net/npm/@fontsource/geist-sans@5/files/geist-sans-latin-700-normal.woff2" />

    <script is:inline>
      const stored = localStorage.getItem('theme');
      if (stored === 'light') {
        document.documentElement.classList.add('light');
      }
    </script>

    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-[color:var(--color-brand-500)] focus:text-white focus:font-medium">
      Skip to main content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!--
      First-party, cookieless pageview beacon → /api/hit (Analytics Engine).

      OWN-VISIT EXCLUSION: open any page with `?vx-ignore=1` and this browser
      stops sending hits for good; `?vx-ignore=0` undoes it. Without it the
      owner's own clicks land as ordinary visitors and quietly distort which
      pages look popular — on folositor.ro a page read as a two-day #1 purely
      from self-visits, and the ranking led to a wrong call about what content
      to keep building.

      The flag lives in localStorage, so it is per-browser and per-device: set
      it again on your phone, and in any other browser or private window.
    -->
    <script is:inline>
      (function () {
        try {
          var q = location.search;
          if (q.indexOf('vx-ignore=1') > -1) localStorage.setItem('vx-ignore', '1');
          if (q.indexOf('vx-ignore=0') > -1) localStorage.removeItem('vx-ignore');
          if (localStorage.getItem('vx-ignore') === '1') return;
          var b = JSON.stringify({ p: location.pathname, r: document.referrer, w: navigator.webdriver ? 1 : 0 });
          if (navigator.sendBeacon) navigator.sendBeacon('/api/hit', new Blob([b], { type: 'application/json' }));
          else fetch('/api/hit', { method: 'POST', body: b, keepalive: true });
        } catch (e) {}
      })();
    </script>
  </body>
</html>
