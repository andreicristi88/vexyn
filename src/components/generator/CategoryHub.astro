---
/**
 * A category landing page — lists every generator in the category as cards.
 * Data-driven from generators.ts, same as everything else.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../lib/constants';
import { breadcrumbSchema, itemListSchema, combineSchemas } from '../../lib/seo';
import { generatorsIn, type Category } from '../../lib/generators';

interface Props {
  category: Category;
}
const { category: c } = Astro.props;
const gens = generatorsIn(c.id);

const title = `${c.name} — Free AI Generators, No Signup`;
const description = `${c.tagline} Every generator runs in your browser on your own device — free, unlimited, no account.`;

const schema = combineSchemas(
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: c.name, url: `/${c.id}` },
  ]),
  itemListSchema(gens.map((g) => ({ name: g.name, url: `/${g.slug}`, description: g.tagline }))),
);
---

<BaseLayout title={title} description={description} schema={schema}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
    <nav class="flex items-center gap-2 text-sm text-[color:var(--color-text-mute)] mb-3" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[color:var(--color-text)]">Home</a>
      <span aria-hidden="true">/</span>
      <span class="text-[color:var(--color-text)]">{c.name}</span>
    </nav>

    <header class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-3">{c.icon} {c.name}</h1>
      <p class="text-lg text-[color:var(--color-text-mute)] max-w-2xl">{c.tagline}</p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {gens.map((g) => (
        <a
          href={`/${g.slug}`}
          class="flex items-start gap-3 p-4 rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface)] hover:border-[color:var(--color-brand-500)] transition group"
        >
          <span class="text-2xl">{g.icon}</span>
          <span>
            <span class="flex items-center gap-2">
              <span class="font-semibold group-hover:text-[color:var(--color-brand-400)] transition">{g.name}</span>
              {g.transparent && (
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-[color:var(--color-brand-500)]/15 text-[color:var(--color-brand-400)] uppercase tracking-wide">PNG</span>
              )}
            </span>
            <span class="block text-xs text-[color:var(--color-text-mute)] mt-0.5">{g.tagline}</span>
          </span>
        </a>
      ))}
    </div>

    <p class="mt-10 text-sm text-[color:var(--color-text-mute)]">
      Not sure where to start? The <a href="/" class="text-[color:var(--color-brand-400)] hover:underline">open generator</a> takes any prompt with no styling applied.
    </p>
  </div>
</BaseLayout>
