---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../lib/constants';
import { TOOLS } from '../../lib/tools';
import { breadcrumbSchema, combineSchemas } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const url = `${SITE.url}/blog/${post.id.replace(/\.md$/, '')}`;

// Table of contents from the article's h2 headings. Astro auto-assigns ids.
const toc = headings.filter((h) => h.depth === 2);

const relatedTools = (post.data.related ?? [])
  .map((href: string) => TOOLS.find((t) => `/${t.slug}` === href))
  .filter((t): t is (typeof TOOLS)[number] => Boolean(t && t.available));

const articleSchema = {
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  url,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
  author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    logo: { '@type': 'ImageObject', url: `${SITE.url}/logo-512.png` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
};

const schema = combineSchemas(
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Guides', url: '/blog' },
    { name: post.data.title, url: `/blog/${post.id.replace(/\.md$/, '')}` },
  ]),
  articleSchema,
);

function fmtDate(d: Date): string {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout title={post.data.title} description={post.data.description} schema={schema}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class={toc.length > 1 ? 'lg:grid lg:grid-cols-[1fr_15rem] lg:gap-12 lg:items-start' : ''}>
    <div class="max-w-3xl min-w-0">
    <header class="mb-10">
      <div class="flex items-center gap-2 text-sm text-[color:var(--color-text-mute)] mb-3">
        <a href="/" class="hover:text-[color:var(--color-text)]">Home</a>
        <span>/</span>
        <a href="/blog" class="hover:text-[color:var(--color-text)]">Guides</a>
        <span>/</span>
        <span class="text-[color:var(--color-text)] truncate max-w-[200px] sm:max-w-none">{post.data.title}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4 leading-tight">{post.data.title}</h1>

      <div class="flex flex-wrap items-center gap-3 text-sm text-[color:var(--color-text-mute)]">
        <time datetime={post.data.pubDate.toISOString()} class="font-mono text-xs uppercase tracking-wider">{fmtDate(post.data.pubDate)}</time>
        {post.data.tags && (
          <>
            <span class="text-[color:var(--color-text-dim)]">·</span>
            <div class="flex flex-wrap gap-1.5">
              {post.data.tags.map((tag: string) => (
                <span class="text-[10px] uppercase tracking-wider px-2 py-0.5 rounded bg-[color:var(--color-surface-2)] text-[color:var(--color-text-mute)] border border-[color:var(--color-border)]">{tag}</span>
              ))}
            </div>
          </>
        )}
      </div>
    </header>

    <article class="prose-vexyn">
      <Content />
    </article>

    {relatedTools.length > 0 && (
      <aside class="mt-12 p-5 rounded-xl bg-gradient-to-br from-[color:var(--color-brand-500)]/10 to-[color:var(--color-accent-500)]/10 border border-[color:var(--color-brand-500)]/30">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-[color:var(--color-text-mute)] mb-3">The tool for this</h2>
        <div class="flex flex-wrap gap-2">
          {relatedTools.map((t) => (
            <a href={`/${t.slug}`} class="text-sm px-4 py-2 rounded-lg bg-[color:var(--color-surface)] border border-[color:var(--color-border)] hover:border-[color:var(--color-brand-500)] text-[color:var(--color-text)] hover:text-[color:var(--color-brand-400)] transition-colors">{t.name} →</a>
          ))}
        </div>
      </aside>
    )}

    <nav class="mt-12 pt-6 border-t border-[color:var(--color-border)]">
      <a href="/blog" class="text-sm text-[color:var(--color-brand-400)] hover:text-[color:var(--color-brand-300)] transition-colors">← All guides</a>
    </nav>
    </div>

    {toc.length > 1 && (
      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <p class="text-xs font-semibold uppercase tracking-wider text-[color:var(--color-text-dim)] mb-3">On this page</p>
          <nav class="vexyn-toc border-l border-[color:var(--color-border)]">
            <ul class="space-y-1 text-sm">
              {toc.map((h) => (
                <li>
                  <a
                    href={`#${h.slug}`}
                    data-toc-link={h.slug}
                    class="block -ml-px pl-4 py-1 border-l border-transparent text-[color:var(--color-text-mute)] hover:text-[color:var(--color-text)] hover:border-[color:var(--color-border-strong)] transition-colors leading-snug"
                  >{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </aside>
    )}
    </div>
  </div>

  {toc.length > 1 && (
    <script>
      const links = new Map(
        [...document.querySelectorAll('[data-toc-link]')].map((a) => [
          a.getAttribute('data-toc-link'),
          a,
        ]),
      );
      let current: string | null = null;
      const setActive = (id: string | null) => {
        if (id === current) return;
        if (current && links.get(current)) {
          links.get(current)!.classList.remove('toc-active');
        }
        current = id;
        if (id && links.get(id)) links.get(id)!.classList.add('toc-active');
      };
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible[0]) setActive(visible[0].target.id);
        },
        { rootMargin: '-80px 0px -70% 0px', threshold: 0 },
      );
      document
        .querySelectorAll('.prose-vexyn h2[id]')
        .forEach((h) => observer.observe(h));
    </script>
  )}
</BaseLayout>

<style is:global>
  .prose-vexyn { color: var(--color-text); font-size: 1rem; line-height: 1.75; counter-reset: vexsec; }
  .prose-vexyn > * + * { margin-top: 1.25em; }
  .prose-vexyn h2 { display: flex; align-items: center; gap: 0.65rem; font-size: 1.5rem; font-weight: 700; margin-top: 2.5em; margin-bottom: 0.75em; letter-spacing: -0.01em; scroll-margin-top: 6rem; counter-increment: vexsec; }
  .prose-vexyn h2::before {
    content: counter(vexsec);
    flex: none;
    display: grid; place-items: center;
    width: 1.7em; height: 1.7em;
    font-size: 0.7em; font-weight: 700; line-height: 1;
    color: var(--color-brand-400);
    background: color-mix(in srgb, var(--color-brand-500) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-brand-500) 30%, transparent);
    border-radius: 8px;
  }
  /* Numbered TOC — counter runs in the same document order as the h2 badges, so numbers match. */
  .vexyn-toc ul { counter-reset: vextoc; }
  .vexyn-toc a[data-toc-link] { counter-increment: vextoc; }
  .vexyn-toc a[data-toc-link]::before {
    content: counter(vextoc);
    display: inline-block;
    width: 1.4em; margin-right: 0.2em;
    font-variant-numeric: tabular-nums;
    font-weight: 600; color: var(--color-text-dim);
  }
  .vexyn-toc a.toc-active { color: var(--color-brand-400); border-left-color: var(--color-brand-500); font-weight: 500; }
  .vexyn-toc a.toc-active::before { color: var(--color-brand-400); }
  .prose-vexyn h3 { font-size: 1.15rem; font-weight: 600; margin-top: 2em; margin-bottom: 0.5em; }
  .prose-vexyn p { color: var(--color-text); }
  .prose-vexyn a { color: var(--color-brand-400); text-decoration: none; border-bottom: 1px solid color-mix(in srgb, var(--color-brand-400) 30%, transparent); transition: border-color 0.15s; }
  .prose-vexyn a:hover { border-bottom-color: var(--color-brand-400); }
  .prose-vexyn ul, .prose-vexyn ol { padding-left: 1.5rem; }
  .prose-vexyn li { margin-top: 0.5em; }
  .prose-vexyn ul li { list-style: disc; }
  .prose-vexyn ol li { list-style: decimal; }
  .prose-vexyn strong { color: var(--color-text); font-weight: 600; }
  .prose-vexyn code { font-family: var(--font-mono); font-size: 0.875em; padding: 0.15em 0.4em; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 4px; color: var(--color-brand-400); }
  .prose-vexyn pre { border: 1px solid var(--color-border); border-radius: 8px; padding: 1rem 1.25rem; overflow-x: auto; font-size: 0.875em; line-height: 1.6; background: var(--color-surface); }
  .prose-vexyn pre code { padding: 0; background: transparent; border: none; color: var(--color-text-mute); }
  .prose-vexyn hr { border: none; height: 1px; background: var(--color-border); margin: 3em 0; }
  .prose-vexyn blockquote { border-left: 3px solid var(--color-brand-500); padding-left: 1rem; margin-left: 0; color: var(--color-text-mute); font-style: italic; }
  .prose-vexyn table { width: 100%; border-collapse: collapse; font-size: 0.9em; }
  .prose-vexyn th, .prose-vexyn td { border: 1px solid var(--color-border); padding: 0.5em 0.75em; text-align: left; }
  .prose-vexyn th { background: var(--color-surface-2); font-weight: 600; }
</style>
