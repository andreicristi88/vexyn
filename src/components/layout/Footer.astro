---
import { SITE } from '../../lib/constants';
import { ZONES, toolsInZone } from '../../lib/tools';
import Logo from '../ui/Logo.astro';

const year = new Date().getFullYear();

// Show the available tools first in each zone, then fill up to 5 with the
// roadmap so the footer reflects both what works and what is coming.
function footerTools(zoneId: (typeof ZONES)[number]['id']) {
  const list = toolsInZone(zoneId);
  const available = list.filter((t) => t.available);
  const coming = list.filter((t) => !t.available);
  return [...available, ...coming].slice(0, 5);
}
---

<footer class="border-t border-[color:var(--color-border)] mt-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <div class="col-span-2 md:col-span-1">
        <div class="flex items-center gap-2 mb-3">
          <Logo size={28} />
          <span class="font-semibold">{SITE.name}</span>
        </div>
        <p class="text-sm text-[color:var(--color-text-mute)] leading-relaxed">
          {SITE.tagline} Clean, convert and analyze financial data without uploading it anywhere.
        </p>
      </div>

      {ZONES.map((zone) => (
        <div>
          <h3 class="text-sm font-semibold mb-3">{zone.name}</h3>
          <ul class="space-y-2 text-sm text-[color:var(--color-text-mute)]">
            {footerTools(zone.id).map((t) => (
              <li>
                {t.available ? (
                  <a href={`/${t.slug}`} class="hover:text-[color:var(--color-text)]">{t.name}</a>
                ) : (
                  <span class="text-[color:var(--color-text-dim)]">{t.name} <span class="text-[10px] uppercase tracking-wider">soon</span></span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10 pt-6 border-t border-[color:var(--color-border)] flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-[color:var(--color-text-dim)]">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <a href="/about" class="hover:text-[color:var(--color-text-mute)]">About</a>
        <a href="/privacy" class="hover:text-[color:var(--color-text-mute)]">Privacy</a>
        <a href={SITE.github} target="_blank" rel="noopener noreferrer" class="hover:text-[color:var(--color-text-mute)]">GitHub</a>
        <a href="/sitemap-index.xml" class="hover:text-[color:var(--color-text-mute)]">Sitemap</a>
      </div>
      <p class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-[color:var(--color-success)] animate-pulse"></span>
        <span>No upload. No tracking. No accounts.</span>
      </p>
    </div>
    <p class="mt-4 text-xs text-[color:var(--color-text-dim)]">© {year} {SITE.name}.</p>
  </div>
</footer>
