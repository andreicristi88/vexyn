---
/**
 * Renders one generator page entirely from its data object: breadcrumb, hero,
 * the generator island, "how it works", FAQ, related links and the licence
 * note. Adding a page is adding a Generator in generators.ts — never a file.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageGenerator from './ImageGenerator.svelte';
import { SITE, MODEL } from '../../lib/constants';
import { breadcrumbSchema, faqSchema, webAppSchema, combineSchemas } from '../../lib/seo';
import { getCategory, getGenerator, type Generator } from '../../lib/generators';

interface Props {
  generator: Generator;
}
const { generator: g } = Astro.props;
const cat = getCategory(g.category);
const path = `/${g.slug}`;
const related = g.related.map((s) => getGenerator(s)).filter(Boolean) as Generator[];

const features = [
  'Text-to-image generation in your browser',
  'Prompts never sent to a server',
  'No account, no queue, no generation limit',
  'Works offline once the model is cached',
  ...(g.transparent ? ['One-click transparent PNG (background removed on-device)'] : []),
  `Open model — ${MODEL.id} (${MODEL.licence})`,
];

const schema = combineSchemas(
  webAppSchema({
    name: `${g.title} — ${SITE.name}`,
    url: `${SITE.url}${path}`,
    description: g.description,
    category: 'MultimediaApplication',
    features,
  }),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: cat.name, url: `/${cat.id}` },
    { name: g.name, url: path },
  ]),
  faqSchema(g.faqs),
);
---

<BaseLayout title={g.title} description={g.description} schema={schema}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
    <nav class="flex items-center gap-2 text-sm text-[color:var(--color-text-mute)] mb-3" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[color:var(--color-text)]">Home</a>
      <span aria-hidden="true">/</span>
      <a href={`/${cat.id}`} class="hover:text-[color:var(--color-text)]">{cat.name}</a>
      <span aria-hidden="true">/</span>
      <span class="text-[color:var(--color-text)]">{g.name}</span>
    </nav>

    <header class="mb-6">
      <div class="flex items-center gap-3 mb-3 flex-wrap">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">{g.icon} {g.h1}</h1>
        <span class="text-xs px-2 py-1 rounded-md bg-[color:var(--color-accent-500)]/15 border border-[color:var(--color-accent-500)]/30 text-[color:var(--color-accent-400)] font-medium uppercase tracking-wider">
          Runs locally
        </span>
      </div>
      <p class="text-lg text-[color:var(--color-text-mute)] max-w-2xl">{g.intro}</p>
    </header>

    <ImageGenerator source={g} client:load />

    <!-- How it works -->
    <section class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="p-4 rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface)]">
        <div class="flex items-center gap-2 mb-2">
          <span class="w-6 h-6 rounded-full bg-[color:var(--color-brand-500)]/15 text-[color:var(--color-brand-400)] text-xs font-mono flex items-center justify-center">1</span>
          <span class="text-sm font-semibold">Load once</span>
        </div>
        <p class="text-xs text-[color:var(--color-text-mute)] leading-relaxed">
          The model downloads to your browser and stays cached. One wait, at the start — never again.
        </p>
      </div>
      <div class="p-4 rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface)]">
        <div class="flex items-center gap-2 mb-2">
          <span class="w-6 h-6 rounded-full bg-[color:var(--color-brand-500)]/15 text-[color:var(--color-brand-400)] text-xs font-mono flex items-center justify-center">2</span>
          <span class="text-sm font-semibold">Your device does the work</span>
        </div>
        <p class="text-xs text-[color:var(--color-text-mute)] leading-relaxed">
          A single denoising step runs on your own GPU or CPU. No API call, no credit counter, no queue.
        </p>
      </div>
      <div class="p-4 rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface)]">
        <div class="flex items-center gap-2 mb-2">
          <span class="w-6 h-6 rounded-full bg-[color:var(--color-brand-500)]/15 text-[color:var(--color-brand-400)] text-xs font-mono flex items-center justify-center">3</span>
          <span class="text-sm font-semibold">Keep what you make</span>
        </div>
        <p class="text-xs text-[color:var(--color-text-mute)] leading-relaxed">
          {g.transparent ? 'Download as PNG, transparent or not.' : 'Download as PNG.'} The model licence
          permits commercial use — your output is yours.
        </p>
      </div>
    </section>

    <article class="prose mt-14 max-w-3xl">
      <slot />

      <h2 class="text-2xl font-bold mb-4 mt-12">FAQ</h2>
      <div class="space-y-4">
        {g.faqs.map((f) => (
          <div>
            <h3 class="font-semibold mb-1">{f.q}</h3>
            <p class="text-[color:var(--color-text-mute)]">{f.a}</p>
          </div>
        ))}
      </div>

      {related.length > 0 && (
        <>
          <h2 class="text-2xl font-bold mb-4 mt-12">Related generators</h2>
          <div class="not-prose grid grid-cols-1 sm:grid-cols-3 gap-3">
            {related.map((r) => (
              <a
                href={`/${r.slug}`}
                class="flex items-center gap-2 p-3 rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface)] hover:border-[color:var(--color-brand-500)] transition group"
              >
                <span class="text-xl">{r.icon}</span>
                <span class="text-sm font-medium group-hover:text-[color:var(--color-brand-400)] transition">{r.name}</span>
              </a>
            ))}
          </div>
        </>
      )}

      <p class="mt-12 text-xs text-[color:var(--color-text-dim)] leading-relaxed border-t border-[color:var(--color-border)] pt-6">
        Images are generated with <a class="text-[color:var(--color-brand-400)] hover:underline" href={MODEL.url} target="_blank" rel="noopener noreferrer">{MODEL.id}</a>,
        released under the <a class="text-[color:var(--color-brand-400)] hover:underline" href={MODEL.licenceUrl} target="_blank" rel="noopener noreferrer">{MODEL.licence}</a> licence.
        That licence permits commercial use and carries use restrictions that also apply to you — see our
        <a class="text-[color:var(--color-brand-400)] hover:underline" href="/about">terms</a>.
      </p>
    </article>
  </div>
</BaseLayout>
