---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/ui/Faq.astro';
import CsvMerger from '../components/tools/CsvMerger.svelte';
import PrivacyNote from '../components/ui/PrivacyNote.astro';
import { SITE } from '../lib/constants';
import { breadcrumbSchema, faqSchema, webAppSchema, combineSchemas } from '../lib/seo';

const title = 'CSV Merger';
const description =
  'Free tool to merge multiple CSV files into one. Columns are aligned by name, so files with slightly different headers combine cleanly. Runs in your browser — nothing uploaded.';

const faqs = [
  { q: 'What if the files have different columns?', a: 'They still merge. Columns are matched by header name (ignoring case and spaces), and the result is the union of all columns. A file missing a column simply has blanks for it — nothing is dropped or misaligned.' },
  { q: 'Does the row order stay the same?', a: 'Yes. Rows are appended in the order you add the files, and within each file in their original order.' },
  { q: 'Is my data uploaded?', a: 'No. All files are read and merged in your browser. Open DevTools → Network — your file is never sent out. Safe for bank and transaction exports.' },
  { q: 'How many files can I merge?', a: 'As many as your browser memory allows — typically dozens of normal exports. Each file is capped at about 50 MB.' },
  { q: 'Are values changed?', a: 'No. Every value is carried across exactly, including leading zeros and formatting. Only the columns are aligned.' },
];

const schema = combineSchemas(
  webAppSchema({
    name: `${title} — ${SITE.name}`,
    url: `${SITE.url}/csv-merger`,
    description,
    category: 'BusinessApplication',
    features: ['Merge many CSVs into one', 'Columns aligned by header name', 'Union of all columns, no data dropped', 'Runs entirely in your browser, no upload'],
  }),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'CSV Merger', url: '/csv-merger' },
  ]),
  faqSchema(faqs),
);
---

<BaseLayout title={title} description={description} schema={schema}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-8">
      <div class="flex items-center gap-2 text-sm text-[color:var(--color-text-mute)] mb-3">
        <a href="/" class="hover:text-[color:var(--color-text)]">Home</a>
        <span>/</span>
        <span class="text-[color:var(--color-text)]">CSV Merger</span>
      </div>
      <h1 class="text-4xl font-bold tracking-tight mb-3">CSV Merger</h1>
      <p class="text-lg text-[color:var(--color-text-mute)] max-w-2xl">
        Combine several CSV files into one. Columns are matched by name, so monthly exports with slightly different headers merge cleanly. All in your browser.
      </p>
    </header>

    <PrivacyNote text="Your files are merged in your browser. Open DevTools → Network to verify — your file is never uploaded." />
    <CsvMerger client:load />

    <article class="prose mt-16 max-w-3xl">
      <h2 class="text-2xl font-bold mb-4">Merging by name, not by position</h2>
      <p class="text-[color:var(--color-text-mute)] leading-relaxed mb-6">
        The naive way to combine CSVs — stacking them and hoping the columns line up — breaks the moment one export adds a column or lists them in a different order. This tool matches columns by their header name instead, so twelve monthly bank exports become one clean file even if the bank tweaked the format halfway through the year.
      </p>
    </article>

    <Faq faqs={faqs} />
  </div>
</BaseLayout>
