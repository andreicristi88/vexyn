---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/ui/Faq.astro';
import RelatedGuides from '../components/ui/RelatedGuides.astro';
import CsvToExcel from '../components/tools/CsvToExcel.svelte';
import PrivacyNote from '../components/ui/PrivacyNote.astro';
import { SITE } from '../lib/constants';
import { breadcrumbSchema, faqSchema, webAppSchema, combineSchemas } from '../lib/seo';

const title = 'CSV to Excel';
const description =
  'Free CSV to Excel converter that runs in your browser. Turn any CSV or bank export into a real .xlsx file — with leading zeros and long numbers kept intact. Nothing is uploaded.';

const faqs = [
  { q: 'Does it keep leading zeros and long numbers?', a: 'Yes. Every value is written to the Excel file as text, so account numbers like 00123 keep their zeros and long card or IBAN numbers do not turn into scientific notation (1.23E+15). This is the single most common way CSV-to-Excel tools silently corrupt financial data — this one refuses to.' },
  { q: 'Is my file uploaded?', a: 'No. The CSV is parsed and the .xlsx is built entirely in your browser. Open DevTools → Network — your file is never sent out. That matters for bank exports and payment reports you would not hand to a random converter.' },
  { q: 'Is the output a real Excel file?', a: 'Yes — a genuine .xlsx that opens in Excel, Google Sheets, LibreOffice Calc, and Numbers. The header row is bold; the rest is your data.' },
  { q: 'What delimiters work?', a: 'Comma, semicolon, tab and pipe are detected automatically, so European semicolon exports convert the same as comma files.' },
  { q: 'How large a file can it handle?', a: 'Up to about 50 MB comfortably — tens of thousands of rows. It all runs on your CPU, so very large files depend on your machine.' },
];

const schema = combineSchemas(
  webAppSchema({
    name: `${title} — ${SITE.name}`,
    url: `${SITE.url}/csv-to-excel`,
    description,
    category: 'BusinessApplication',
    features: [
      'Real .xlsx output (Excel, Sheets, LibreOffice, Numbers)',
      'Values kept as text — no corrupted account numbers',
      'Automatic delimiter detection',
      'Runs entirely in your browser, no upload',
    ],
  }),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'CSV to Excel', url: '/csv-to-excel' },
  ]),
  faqSchema(faqs),
);
---

<BaseLayout title={title} description={description} schema={schema}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-8">
      <div class="flex items-center gap-2 text-sm text-[color:var(--color-text-mute)] mb-3">
        <a href="/" class="hover:text-[color:var(--color-text)]">Home</a>
        <span>/</span>
        <span class="text-[color:var(--color-text)]">CSV to Excel</span>
      </div>
      <h1 class="text-4xl font-bold tracking-tight mb-3">CSV to Excel</h1>
      <p class="text-lg text-[color:var(--color-text-mute)] max-w-2xl">
        Convert a CSV into a real Excel .xlsx file — with your account numbers and long values kept exactly as written. Everything runs in your browser.
      </p>
    </header>

    <PrivacyNote text="Your CSV is converted in your browser. Open DevTools → Network to verify — your file is never uploaded." />
    <CsvToExcel client:load />

    <article class="prose mt-16 max-w-3xl">
      <h2 class="text-2xl font-bold mb-4">Why "just open it in Excel" corrupts your data</h2>
      <p class="text-[color:var(--color-text-mute)] leading-relaxed mb-6">
        When you double-click a CSV, Excel guesses the type of every value. An account number like <code class="text-[color:var(--color-brand-400)]">00123</code> loses its leading zeros; a 16-digit card number becomes <code class="text-[color:var(--color-brand-400)]">1.23457E+15</code>; a value like <code class="text-[color:var(--color-brand-400)]">3-5</code> can turn into a date. Once saved, that damage is permanent. This converter writes every cell as text, so what you see in the CSV is exactly what lands in the spreadsheet.
      </p>
    </article>

    <RelatedGuides />

    <Faq faqs={faqs} />
  </div>
</BaseLayout>
