---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/ui/Faq.astro';
import CashFlowAnalyzer from '../components/tools/CashFlowAnalyzer.svelte';
import PrivacyNote from '../components/ui/PrivacyNote.astro';
import { SITE } from '../lib/constants';
import { breadcrumbSchema, faqSchema, webAppSchema, combineSchemas } from '../lib/seo';

const title = 'Cash Flow Analyzer';
const description =
  'Free cash flow analyzer for your bank statement. See money in vs money out, month by month, from any CSV export — entirely in your browser. Your statement is never uploaded.';

const faqs = [
  { q: 'Is my bank statement uploaded?', a: 'No. The CSV is read and analyzed entirely in your browser. Open DevTools → Network — your file is never sent out. This is exactly the kind of data you should not hand to a random online tool.' },
  { q: 'What CSV do I need?', a: 'Any bank export with a date column and either a single signed amount column or separate debit/credit columns. You map the columns yourself, so it works with any bank’s format.' },
  { q: 'My spending shows as positive numbers. Does that break it?', a: 'No. If your bank writes debits as positive numbers, tick "Spending shows as a positive number" under the Amount column and the direction flips correctly.' },
  { q: 'It skipped some rows — why?', a: 'A row is skipped only when its date or amount cannot be read, and the count is shown. That is almost always the wrong date format or decimal separator — change the two selectors and the rows come back. Nothing is ever guessed.' },
  { q: 'Does it handle European number and date formats?', a: 'Yes. Choose day-first dates (31/01/2026) and the comma decimal (1.234,56) in the selectors. Amounts and dates are parsed exactly as you specify, never auto-guessed into the wrong interpretation.' },
  { q: 'Are my numbers accurate?', a: 'The totals are a plain sum of the rows you mapped — money in is the sum of positive amounts, money out the sum of negatives. It does not categorize or interpret anything, so there is nothing to get subtly wrong. Spot-check a month against your statement to confirm the mapping.' },
];

const schema = combineSchemas(
  webAppSchema({
    name: `${title} — ${SITE.name}`,
    url: `${SITE.url}/cash-flow-analyzer`,
    description,
    category: 'FinanceApplication',
    features: [
      'Money in vs money out, grouped by month',
      'Works with any bank CSV via column mapping',
      'Single signed amount or separate debit/credit columns',
      'Explicit date-format and decimal-separator control',
      'Runs entirely in your browser, no upload',
    ],
  }),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Cash Flow Analyzer', url: '/cash-flow-analyzer' },
  ]),
  faqSchema(faqs),
);
---

<BaseLayout title={title} description={description} schema={schema}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-8">
      <div class="flex items-center gap-2 text-sm text-[color:var(--color-text-mute)] mb-3">
        <a href="/" class="hover:text-[color:var(--color-text)]">Home</a>
        <span>/</span>
        <span class="text-[color:var(--color-text)]">Cash Flow Analyzer</span>
      </div>
      <h1 class="text-4xl font-bold tracking-tight mb-3">Cash Flow Analyzer</h1>
      <p class="text-lg text-[color:var(--color-text-mute)] max-w-2xl">
        Drop a bank statement CSV and see where you stand: money in versus money out, month by month. Everything runs in your browser — your statement is never uploaded.
      </p>
    </header>

    <PrivacyNote text="Your statement is analyzed in your browser. Open DevTools → Network to verify — your file is never uploaded." />
    <CashFlowAnalyzer client:load />

    <article class="prose mt-16 max-w-3xl">
      <h2 class="text-2xl font-bold mb-4">A clear picture of money in and out</h2>
      <p class="text-[color:var(--color-text-mute)] leading-relaxed mb-6">
        Bank statements list every transaction but never the one thing you actually want: are you spending more than you bring in, and when? This tool groups your transactions by month and sums the two directions, so a year of rows becomes a short table and a chart you can read in seconds.
      </p>

      <h2 class="text-2xl font-bold mb-4 mt-10">Why it maps columns instead of guessing</h2>
      <p class="text-[color:var(--color-text-mute)] leading-relaxed mb-6">
        Every bank names its columns differently and formats dates and numbers differently. Rather than guess — and risk reading <code class="text-[color:var(--color-brand-400)]">01/02</code> as the wrong month, or a comma as a thousands separator — you pick the date, amount and format explicitly. It is one extra step that makes the totals trustworthy.
      </p>
    </article>

    <Faq faqs={faqs} />
  </div>
</BaseLayout>
